# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Server-side only — used by api/chat.ts, set in Vercel dashboard for deploys.
GEMINI_API_KEY=

# Client-side, embedded into the Expo bundle at build time (EXPO_PUBLIC_ prefix
# makes it safe to expose — it's just the API's base URL, not a secret).
EXPO_PUBLIC_API_URL=https://your-project.vercel.app
